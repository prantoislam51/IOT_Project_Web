# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/smart-attendance

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET=change-me-generate-a-long-random-string

# Base URL of the Next.js app
NEXTAUTH_URL=http://localhost:3000

# Shared secret used when registering devices / signing device API keys
DEVICE_API_SECRET=change-me-device-secret

# Application timezone (intended: Asia/Dhaka)
APP_TIMEZONE=Asia/Dhaka
